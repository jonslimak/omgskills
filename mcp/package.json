{
  "name": "omgskills-mcp",
  "version": "0.1.1",
  "description": "Read-only MCP server for searching the omgskills agent skill library.",
  "homepage": "https://omgskills.com/developers/",
  "bugs": "https://github.com/jonslimak/omgskills/issues",
  "keywords": [
    "agent-skills",
    "claude",
    "codex",
    "mcp",
    "model-context-protocol",
    "omgskills"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jonslimak/omgskills.git",
    "directory": "mcp"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "omgskills-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && tsx --test test/*.test.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "smoke": "tsx src/smoke.ts",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
