{
  "name": "omgskills",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "workspaces": [
    "portal"
  ],
  "scripts": {
    "build": "npm run build:netlify",
    "build:netlify": "node ./scripts/build-netlify-site.mjs",
    "build:portal": "npm --workspace portal run build",
    "check": "npm run check:creator-handle-reservations && npm run test:creator-handle-reservations && npm run test:sync-skill && npm run test:device-auth && npm run test:portal-grouping && tsc --noEmit",
    "check:creator-handle-reservations": "node ./scripts/generate-creator-handle-reservations.mjs --check",
    "dev": "netlify dev",
    "dev:portal": "npm --workspace portal run dev",
    "generate:creator-handle-reservations": "node ./scripts/generate-creator-handle-reservations.mjs",
    "test": "npm run check",
    "test:creator-handle-reservations": "node --test ./scripts/generate-creator-handle-reservations.test.mjs && tsx --test ./netlify/functions/_shared/reserved.test.ts",
    "test:sync-skill": "tsx --test ./netlify/functions/_shared/sync-skill.test.ts",
    "test:device-auth": "tsx --test ./netlify/functions/_shared/device-auth.test.ts ./netlify/functions/_shared/browser-pairing.test.ts",
    "test:device-auth-integration": "tsx --test ./netlify/functions/_shared/device-pairing.integration.test.ts",
    "test:device-upload-integration": "tsx --test ./netlify/functions/_shared/device-upload.integration.test.ts",
    "test:portal-grouping": "tsx --test ./portal/tests/synced-skill-grouping.test.ts ./portal/tests/browser-pairing.test.ts",
    "verify:skillgroups-rollout": "node ./scripts/verify-skillgroups-rollout.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^2.3.0",
    "@netlify/database": "^1.0.0",
    "@netlify/functions": "^3.0.0",
    "drizzle-orm": "^0.44.2",
    "pg": "^8.16.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.4",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.2",
    "netlify-cli": "^26.1.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  }
}
