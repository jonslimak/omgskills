{
  "name": "omgskills",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "workspaces": [
    "portal"
  ],
  "scripts": {
    "build": "npm run build:netlify",
    "build:netlify": "node ./scripts/build-netlify-site.mjs",
    "build:portal": "npm --workspace portal run build",
    "check": "npm run check:creator-handle-reservations && npm run test:creator-handle-reservations && npm run test:sync-skill && npm run test:database-routing && npm run test:device-auth && npm run test:deploy-safety && npm run test:published-data && npm run test:portal-grouping && npm run test:public-skill-links && npm run test:group-item-resolution && tsc --noEmit",
    "check:creator-handle-reservations": "node ./scripts/generate-creator-handle-reservations.mjs --check",
    "dev": "netlify dev",
    "dev:portal": "npm --workspace portal run dev",
    "deploy:production": "node ./scripts/deploy-netlify-production.mjs",
    "generate:creator-handle-reservations": "node ./scripts/generate-creator-handle-reservations.mjs",
    "test": "npm run check",
    "test:creator-handle-reservations": "node --test ./scripts/generate-creator-handle-reservations.test.mjs && tsx --test ./netlify/functions/_shared/reserved.test.ts ./netlify/functions/_shared/group-slug.test.ts",
    "test:sync-skill": "tsx --test ./netlify/functions/_shared/sync-skill.test.ts",
    "test:database-routing": "tsx --test ./netlify/functions/_shared/db.test.ts",
    "test:device-auth": "tsx --test ./netlify/functions/_shared/device-auth.test.ts ./netlify/functions/_shared/browser-pairing.test.ts",
    "test:device-auth-integration": "tsx --test ./netlify/functions/_shared/device-pairing.integration.test.ts",
    "test:device-upload-integration": "tsx --test ./netlify/functions/_shared/device-upload.integration.test.ts",
    "test:deploy-safety": "node --test ./scripts/deploy-artifact-guard.test.mjs ./scripts/deploy-netlify-production.test.mjs ./scripts/deploy-site-prod.test.mjs ./scripts/health-snapshot-guard.test.mjs ./scripts/homepage-library-preview.test.mjs ./scripts/policy-observation-workflow.test.mjs ./scripts/policy-validation-gates.test.mjs ./scripts/prepare-netlify-site-deploy.test.mjs ./scripts/publication-impact-workflows.test.mjs ./scripts/publish-collections-prod.test.mjs ./scripts/publish-collections-workflow.test.mjs ./scripts/release-mac.test.mjs ./scripts/shadow-crawl-workflow.test.mjs ./scripts/v2-policy-workflow.test.mjs ./scripts/verify-menubar-library-input.test.mjs ./scripts/verify-production-deploy.test.mjs ./scripts/web-library-skill-urls.test.mjs && npm run test:workflow-writer-locks",
    "test:workflow-writer-locks": "node --test ./scripts/check-active-data-writers.test.mjs ./scripts/check-workflow-writer-locks.test.mjs ./scripts/pipeline-health-workflow.test.mjs ./scripts/publication-impact-workflows.test.mjs && node ./scripts/check-workflow-writer-locks.mjs",
    "test:published-data": "node --test ./scripts/verify-published-data.test.mjs",
    "test:portal-grouping": "tsx --test ./portal/tests/synced-skill-grouping.test.ts ./portal/tests/browser-pairing.test.ts ./portal/tests/feature-flags.test.ts",
    "test:public-skill-links": "tsx --test ./netlify/functions/_shared/public-skill-links.test.ts",
    "test:group-item-resolution": "tsx --test ./netlify/functions/_shared/published-catalog.test.ts ./netlify/functions/_shared/github-skill-resolution.test.ts",
    "verify:skillgroups-rollout": "node ./scripts/verify-skillgroups-rollout.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^2.3.0",
    "@netlify/database": "^1.0.0",
    "@netlify/functions": "^3.0.0",
    "drizzle-orm": "^0.44.2",
    "pg": "^8.16.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.4",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.2",
    "netlify-cli": "^26.1.0",
    "tsx": "^4.22.4",
    "typescript": "^5.8.3"
  }
}
