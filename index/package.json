{
  "name": "omgskills-index",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "scrape": "tsx scraper/build.ts",
    "scrape:shadow": "OMGSKILLS_DISABLE_OCTOKIT_SECONDARY_RETRY=1 tsx scraper/new-crawl/build-shadow.ts",
    "crawl4:add-skill": "tsx scraper/new-crawl/add-curated-skill.ts",
    "crawl4:remove-repo": "tsx scraper/new-crawl/remove-repo.ts",
    "crawl4:removal-audit": "tsx scraper/new-crawl/removal-audit.ts",
    "crawl4:audit-canonical-commits": "OMGSKILLS_DISABLE_OCTOKIT_SECONDARY_RETRY=1 tsx scraper/new-crawl/audit-canonical-commits.ts",
    "crawl4:validate-canonical-policy": "tsx scraper/new-crawl/validate-canonical-policy.ts",
    "crawl4:audit-security": "tsx scraper/new-crawl/audit-security.ts",
    "promote:cutover": "tsx scraper/new-crawl/promote-cutover.ts",
    "test:shadow-guard": "tsx --test scraper/carry-forward.test.ts scraper/runtime-guard.test.ts scraper/new-crawl/*.test.ts scraper/policy/*.test.ts scripts/publish-sha-history.test.ts scripts/publish-skill-equivalence.test.ts",
    "scrape:debug": "tsx scraper/build.ts --sources=aggregators,social,registry,awesome,official --aggregator-repo-limit=10 --social-page-limit=1 --output-suffix=debug --max-enriched=200",
    "scrape:debug:official": "tsx scraper/build.ts --sources=official --output-suffix=debug --max-enriched=100 --max-candidates=150",
    "scrape:debug:skillssh": "tsx scraper/build.ts --sources=skillssh --output-suffix=debug --max-enriched=100 --max-candidates=150",
    "scrape:debug:awesome": "tsx scraper/build.ts --sources=awesome --output-suffix=debug --max-enriched=100 --max-candidates=150",
    "scrape:with-x": "npm run scrape && tsx scraper/run-x-enrichment.ts",
    "scrape:trending": "tsx scraper/build-trending.ts",
    "scrape:x": "tsx scraper/run-x-enrichment.ts",
    "collect:x-skill-tweets": "tsx scraper/collect-x-skill-tweets.ts",
    "merge:x-skill-tweets": "tsx scraper/merge-x-skill-tweets.ts",
    "publish:collections": "tsx scripts/publish-collections.ts",
    "collections:verify-images": "tsx scripts/verify-collection-images.ts",
    "editool": "tsx scripts/editool.ts",
    "test:editool": "tsx --test scripts/editool-*.test.ts scraper/policy/*.test.ts",
    "test:policy": "tsx --test scraper/policy/*.test.ts scripts/replay-policy-observation.test.ts scripts/verify-policy-evidence.test.ts",
    "policy:validate": "tsx scripts/validate-policy.ts",
    "policy:replay": "tsx scripts/replay-policy-observation.ts",
    "policy:evidence": "tsx scripts/verify-policy-evidence.ts",
    "publish:sha-history": "tsx scripts/publish-sha-history.ts",
    "publish:skill-equivalence": "tsx scripts/publish-skill-equivalence.ts",
    "publication:impact": "tsx scripts/publication-impact.ts",
    "typecheck": "tsc --noEmit",
    "content:stats": "tsx scraper/content/compute-stats.ts",
    "content:stats-html": "tsx scraper/content/build-stats-html.ts",
    "content:leaderboards": "tsx scraper/content/build-leaderboards-html.ts",
    "content:fetch-essentials": "tsx scraper/content/fetch-external-essentials.ts",
    "content:build-basket": "tsx scraper/content/build-gold-basket.ts",
    "content:enrich-basket": "tsx scraper/content/enrich-gold-basket.ts",
    "content:overlays": "tsx scraper/content/build-overlays.ts",
    "content:author-leaderboards": "tsx scraper/content/build-author-leaderboards.ts",
    "content:proposed-creators": "tsx scraper/content/build-proposed-creators.ts",
    "content:trending-leaderboard": "tsx scraper/content/build-trending-leaderboard.ts",
    "content:leaderboard-view-data": "tsx scraper/content/build-leaderboard-view-data.ts",
    "content:reports": "tsx scraper/content/build-content-reports.ts",
    "content:generate": "tsx scraper/content/generate-content.ts",
    "content:review-html": "tsx scraper/content/build-review-html.ts",
    "content:growth-html": "tsx scraper/content/build-growth-html.ts",
    "content:dashboard": "tsx scraper/content/build-dashboard.ts"
  },
  "dependencies": {
    "@octokit/plugin-retry": "^7.2.1",
    "@octokit/plugin-throttling": "^9.3.2",
    "@octokit/rest": "^21.0.2",
    "@the-convocation/twitter-scraper": "^0.22.3",
    "dotenv": "^16.4.5",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
